local function singleClick(btn)
    if not isReallyVisible(btn) then return end
    pcall(function()
        local inset = guiService:GetGuiInset()
        local x = btn.AbsolutePosition.X + (btn.AbsoluteSize.X / 2)
        local y = btn.AbsolutePosition.Y + (btn.AbsoluteSize.Y / 2) + inset.Y

        vim:SendMouseButtonEvent(x, y, 0, true, game, 0)
        task.wait(0.08)
        vim:SendMouseButtonEvent(x, y, 0, false, game, 0)
    end)
end

local function isChoicePopupOpen()
    local popup = playerGui:FindFirstChild("MainMenu") 
        and playerGui.MainMenu.Root:FindFirstChild("ChoicePopup")
    
    return popup and isReallyVisible(popup) and isReallyVisible(popup:FindFirstChild("Frame"))
end

local function checkAndClickChoice()
    if not isChoicePopupOpen() then return false end

    local optionsFrame = playerGui.MainMenu.Root.ChoicePopup.Frame:FindFirstChild("Options")
    if not optionsFrame or not isReallyVisible(optionsFrame) then return false end

    for _, targetPhrase in ipairs(prideRouteChoices) do
        local phraseLower = string.lower(targetPhrase)

        for _, elem in ipairs(optionsFrame:GetDescendants()) do
            if isReallyVisible(elem) and (elem:IsA("TextButton") or elem:IsA("TextLabel")) and elem.Text ~= "" then
                if string.find(string.lower(elem.Text), phraseLower, 1, true) then
                    local targetButton = elem:IsA("TextButton") and elem or elem:FindFirstAncestorOfClass("TextButton")

                    if targetButton and isReallyVisible(targetButton) then
                        notify("D666Scripts", "Choice selected: " .. elem.Text, 2)
                        singleClick(targetButton)
                        return true
                    end
                end
            end
        end
    end
    return false
end

local function handleLoopSettles()
    for _, elem in ipairs(playerGui:GetDescendants()) do
        if elem:IsA("TextLabel") and string.find(string.lower(elem.Text), "the loop settles", 1, true) and isReallyVisible(elem) then
            local container = elem:FindFirstAncestorOfClass("Frame") or elem.Parent
            if container and isReallyVisible(container) then
                local isMagic = false
                local isDivine = false
                
                for _, child in ipairs(container:GetDescendants()) do
                    if child:IsA("TextLabel") and isReallyVisible(child) then
                        local t = string.lower(child.Text)
                        if t == "magic" then isMagic = true end
                        if string.find(t, "divine protection", 1, true) then isDivine = true end
                    end
                end
                
                if isMagic then
                    local firstOption, confirmBtn
                    for _, child in ipairs(container:GetDescendants()) do
                        if child:IsA("TextButton") and isReallyVisible(child) then
                            local btnText = string.lower(child.Text)
                            if string.find(btnText, "choose", 1, true) then
                                confirmBtn = child
                            elseif not firstOption then
                                firstOption = child
                            end
                        end
                    end
                    if firstOption then singleClick(firstOption) task.wait(0.4) end
                    if confirmBtn then
                        singleClick(confirmBtn)
                        return true
                    end
                elseif isDivine then
                    local firstOption, takeBtn
                    for _, child in ipairs(container:GetDescendants()) do
                        if (child:IsA("TextButton") or child:IsA("TextLabel")) and isReallyVisible(child) then
                            local textLower = string.lower(child.Text)
                            if string.find(textLower, "take", 1, true) then
                                takeBtn = child:IsA("TextButton") and child or child:FindFirstAncestorOfClass("TextButton")
                            elseif not firstOption and (child:IsA("TextButton") or string.find(textLower, "lvl.0", 1, true) or string.find(textLower, "not yet held", 1, true)) then
                                firstOption = child:IsA("TextButton") and child or child:FindFirstAncestorOfClass("TextButton")
                            end
                        end
                    end
                    if firstOption then singleClick(firstOption) task.wait(0.4) end
                    if takeBtn and isReallyVisible(takeBtn) then
                        singleClick(takeBtn)
                        return true
                    end
                end
            end
        end
    end
    return false
end

