local repo = "https://raw.githubusercontent.com/deividcomsono/Obsidian/main/"
local Library = loadstring(game:HttpGet(repo .. "Library.lua"))()
local ThemeManager = loadstring(game:HttpGet(repo .. "addons/ThemeManager.lua"))()
local SaveManager = loadstring(game:HttpGet(repo .. "addons/SaveManager.lua"))()

local Options = Library.Options
local Toggles = Library.Toggles

local Window = Library:CreateWindow({
	Title = "D666Scripts",
	Footer = "Anti-Detect Version",
	Icon = "rbxassetid://17892890570",
	NotifySide = "Right",
	ShowCustomCursor = true,
})

local Tabs = {
	Main = Window:AddTab("Main", "swords"),
	["UI Settings"] = Window:AddTab("UI Settings", "settings"),
}

local QTEGroup = Tabs.Main:AddGroupbox({
	Side = "Left",
	Name = "Auto QTE (Combat & Training)",
})

QTEGroup:AddToggle("AutoDodge", {
	Text = "Auto Dodge",
	Default = true,
	Tooltip = "Automatically dodges incoming attacks",
})

QTEGroup:AddSlider("DodgeDelay", {
	Text = "Dodge Delay (Seconds)",
	Default = 0.05,
	Min = 0,
	Max = 1,
	Rounding = 2,
	Compact = false,
	Tooltip = "Delay duration before executing dodge",
})

QTEGroup:AddDivider()

QTEGroup:AddToggle("AutoHit", {
	Text = "Auto Hit (Training)",
	Default = true,
	Tooltip = "Automatically hits in training mode",
})

QTEGroup:AddSlider("HitDelay", {
	Text = "Hit Delay (Seconds)",
	Default = 0.20,
	Min = 0,
	Max = 1,
	Rounding = 2,
	Compact = false,
	Tooltip = "Set to 0.20s - 0.30s to avoid anti-cheat timeout",
})

local SettingsGroup = Tabs["UI Settings"]:AddGroupbox({
	Side = "Left",
	Name = "Menu Settings",
})

SettingsGroup:AddToggle("ShowNotifications", {
	Text = "Enable Notifications",
	Default = true,
	Tooltip = "Toggle script pop-up notifications",
})

SettingsGroup:AddDropdown("DPIDropdown", {
	Values = { "50%", "75%", "100%", "125%", "150%", "175%", "200%" },
	Default = "100%",
	Text = "DPI Scale",
	Tooltip = "Change UI scale size",
	Callback = function(Value)
		Value = Value:gsub("%%", "")
		local DPI = tonumber(Value)
		Library:SetDPIScale(DPI)
	end,
})

local Players = game:GetService("Players")
local localPlayer = Players.LocalPlayer
local playerGui = localPlayer:WaitForChild("PlayerGui")

local trackedButtons = setmetatable({}, {__mode = "k"})

local function notify(title, description, timeVal)
	if Toggles.ShowNotifications and Toggles.ShowNotifications.Value then
		Library:Notify({
			Title = title,
			Description = description,
			Time = timeVal or 1.5,
		})
	end
end

local function clickButton(button)
	if firesignal then
		pcall(function() firesignal(button.MouseButton1Click) end)
		pcall(function() firesignal(button.Activated) end)
	elseif getconnections then
		for _, conn in ipairs(getconnections(button.MouseButton1Click)) do
			pcall(function() conn:Fire() end)
		end
		for _, conn in ipairs(getconnections(button.Activated)) do
			pcall(function() conn:Fire() end)
		end
	end
end

local function handleQTE(button)
	if not button:IsA("GuiButton") or trackedButtons[button] then return end

	local buttonText = button:IsA("TextButton") and button.Text or ""
	local combined = (button.Name .. " " .. buttonText):upper()

	local isDodge = combined:find("DODGE")
	local isHit = combined:find("HIT")

	if not (isDodge or isHit) then return end

	trackedButtons[button] = true
	local isProcessing = false

	local function process()
		if isProcessing or not button.Visible then return end
		isProcessing = true

		if isDodge and Toggles.AutoDodge and Toggles.AutoDodge.Value then
			local delayVal = Options.DodgeDelay and Options.DodgeDelay.Value or 0
			if delayVal > 0 then task.wait(delayVal) end

			if button.Visible then
				clickButton(button)
				notify("D666Scripts", "Successfully Dodged!")
			end
		elseif isHit and Toggles.AutoHit and Toggles.AutoHit.Value then
			local delayVal = Options.HitDelay and Options.HitDelay.Value or 0
			if delayVal > 0 then task.wait(delayVal) end

			if button.Visible then
				clickButton(button)
				notify("D666Scripts", "Training Hit Executed!")
			end
		end

		task.wait(0.05)
		isProcessing = false
	end

	if button.Visible then
		task.spawn(process)
	end

	button:GetPropertyChangedSignal("Visible"):Connect(function()
		if button.Visible then
			task.spawn(process)
		end
	end)
end

for _, descendant in ipairs(playerGui:GetDescendants()) do
	handleQTE(descendant)
end

playerGui.DescendantAdded:Connect(function(descendant)
	handleQTE(descendant)
end)

ThemeManager:SetLibrary(Library)
SaveManager:SetLibrary(Library)
ThemeManager:SetFolder("D666Scripts")
SaveManager:SetFolder("D666Scripts/configs")

SaveManager:BuildConfigSection(Tabs["UI Settings"])
ThemeManager:ApplyToTab(Tabs["UI Settings"])

pcall(function()
	ThemeManager:ApplyTheme("Ruby")
end)

if Options and Options.AccentColor then
	Options.AccentColor:SetValueRGB(Color3.fromRGB(255, 30, 30))
end

notify("D666Scripts", "Loaded successfully!", 4)
