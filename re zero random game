function startPrideLoop()
    task.spawn(function()
        notify("D666Scripts", "Pride Route Automator Enabled", 3)
        while getgenv().AutoPride do
            if not isProcessingPride then
                isProcessingPride = true

                if isChoicePopupOpen() then
                    local selected = checkAndClickChoice()
                    task.wait(selected and 3.5 or 1.5)
                elseif handleLoopSettles() then
                    task.wait(2.5)
                elseif clickReadyToGoBack() then
                    task.wait(3.5)
                elseif clickContinueStory() then
                    task.wait(2.5)
                elseif clickReturn() then
                    task.wait(3.0)
                else
                    task.wait(1.0)
                end

                isProcessingPride = false
            end
            task.wait(0.4)
        end
        notify("D666Scripts", "Pride Route Automator Disabled", 3)
    end)
end

