local trackedButtons = setmetatable({}, {__mode = "k"})

local function notify(title, description, timeVal)
	if Toggles.ShowNotifications and Toggles.ShowNotifications.Value then
		Library:Notify({
			Title = title,
			Description = description,
			Time = timeVal or 1.5,
		})
	end
end

local function clickButton(button)
	if firesignal then
		pcall(function() firesignal(button.MouseButton1Click) end)
		pcall(function() firesignal(button.Activated) end)
	elseif getconnections then
		for _, conn in ipairs(getconnections(button.MouseButton1Click)) do
			pcall(function() conn:Fire() end)
		end
		for _, conn in ipairs(getconnections(button.Activated)) do
			pcall(function() conn:Fire() end)
		end
	end
end

local function handleQTE(button)
	if not button:IsA("GuiButton") or trackedButtons[button] then return end

	local buttonText = button:IsA("TextButton") and button.Text or ""
	local combined = (button.Name .. " " .. buttonText):upper()

	local isDodge = combined:find("DODGE")
	local isHit = combined:find("HIT")

	if not (isDodge or isHit) then return end

	trackedButtons[button] = true
	local isProcessing = false

	local function process()
		if isProcessing or not button.Visible then return end
		isProcessing = true

		if isDodge and Toggles.AutoDodge and Toggles.AutoDodge.Value then
			local delayVal = Options.DodgeDelay and Options.DodgeDelay.Value or 0
			if delayVal > 0 then task.wait(delayVal) end

			if button.Visible then
				clickButton(button)
				notify("D666Scripts", "Successfully Dodged!")
			end
		elseif isHit and Toggles.AutoHit and Toggles.AutoHit.Value then
			local delayVal = Options.HitDelay and Options.HitDelay.Value or 0
			if delayVal > 0 then task.wait(delayVal) end

			if button.Visible then
				clickButton(button)
				notify("D666Scripts", "Training Hit Executed!")
			end
		end

		task.wait(0.05)
		isProcessing = false
	end

	if button.Visible then
		task.spawn(process)
	end

	button:GetPropertyChangedSignal("Visible"):Connect(function()
		if button.Visible then
			task.spawn(process)
		end
	end)
end

for _, descendant in ipairs(playerGui:GetDescendants()) do
	handleQTE(descendant)
end

playerGui.DescendantAdded:Connect(function(descendant)
	handleQTE(descendant)
end)

local function getOrderedSkillButtons()
	local buttons = {}
	for _, desc in ipairs(playerGui:GetDescendants()) do
		if desc:IsA("GuiButton") and desc.Visible and desc.AbsoluteSize.X > 0 and desc.AbsoluteSize.Y > 0 then
			local nameUpper = desc.Name:upper()
			local textUpper = (desc:IsA("TextButton") and desc.Text or ""):upper()
			if not (nameUpper:find("DODGE") or nameUpper:find("HIT") or textUpper:find("DODGE") or textUpper:find("HIT")) then
				if desc:FindFirstAncestor("CombatView") or (desc.Parent and (desc.Parent.Name:lower():find("skill") or desc.Parent.Name:lower():find("active") or desc.Parent.Name:lower():find("action") or desc.Parent.Name:lower():find("content"))) then
					table.insert(buttons, desc)
				end
			end
		end
	end

	table.sort(buttons, function(a, b)
		if math.abs(a.AbsolutePosition.Y - b.AbsolutePosition.Y) > 15 then
			return a.AbsolutePosition.Y < b.AbsolutePosition.Y
		end
		return a.AbsolutePosition.X < b.AbsolutePosition.X
	end)

	return buttons
end

task.spawn(function()
	while task.wait() do
		if Toggles.AutoSkill and Toggles.AutoSkill.Value then
			local selected = Options.SelectedSlots and Options.SelectedSlots.Value or {}
			local delayVal = Options.SkillDelay and Options.SkillDelay.Value or 0.5
			local skillButtons = getOrderedSkillButtons()

			if #skillButtons > 0 then
				for slotNum = 1, 10 do
					if not (Toggles.AutoSkill and Toggles.AutoSkill.Value) then break end
					local slotKey = "Slot " .. tostring(slotNum)
					if selected[slotKey] and skillButtons[slotNum] then
						local btn = skillButtons[slotNum]
						if btn and btn.Visible and btn.Parent then
							clickButton(btn)
							task.wait(delayVal)
						end
					end
				end
			else
				task.wait(0.5)
			end
		else
			task.wait(0.5)
		end
	end
end)

