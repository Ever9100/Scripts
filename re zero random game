local function notify(title, description, timeVal)
	if Toggles.ShowNotifications and Toggles.ShowNotifications.Value then
		Library:Notify({
			Title = title,
			Description = description,
			Time = timeVal or 1.5,
		})
	end
end

local function cleanText(str)
	if not str then return "" end
	str = string.lower(str)
	str = str:gsub("[\r\n\t]", " ")
	str = str:gsub("%s+", " ")
	return str:match("^%s*(.-)%s*$") or ""
end

local function singleClick(btn)
	pcall(function()
		local inset = guiService:GetGuiInset()
		local x = btn.AbsolutePosition.X + (btn.AbsoluteSize.X / 2)
		local y = btn.AbsolutePosition.Y + (btn.AbsoluteSize.Y / 2) + inset.Y

		vim:SendMouseButtonEvent(x, y, 0, true, game, 0)
		task.wait(0.08)
		vim:SendMouseButtonEvent(x, y, 0, false, game, 0)
	end)
end

local function clickButton(button)
	if not button then return end
	local clicked = false

	if firesignal then
		pcall(function() firesignal(button.MouseButton1Click) clicked = true end)
		pcall(function() firesignal(button.Activated) clicked = true end)
	elseif getconnections then
		for _, conn in ipairs(getconnections(button.MouseButton1Click)) do
			pcall(function() conn:Fire() clicked = true end)
		end
		for _, conn in ipairs(getconnections(button.Activated)) do
			pcall(function() conn:Fire() clicked = true end)
		end
	end

	if not clicked then
		singleClick(button)
	end
end

local function isReallyVisible(obj)
	if not (obj and obj:IsA("GuiObject")) then return false end
	if obj.AbsoluteSize.X <= 5 or obj.AbsoluteSize.Y <= 5 then return false end

	local current = obj
	while current and current:IsA("GuiObject") do
		if not current.Visible then return false end
		if current:IsA("CanvasGroup") and current.GroupTransparency >= 0.9 then return false end
		current = current.Parent
	end
	return true
end

local function clickChoiceButton(targetButton)
	if not targetButton then return end

	local scroller = targetButton:FindFirstAncestorOfClass("ScrollingFrame")
	if scroller then
		pcall(function()
			local targetY = targetButton.AbsolutePosition.Y
			local scrollerY = scroller.AbsolutePosition.Y
			local currentCanvasY = scroller.CanvasPosition.Y
			local newCanvasY = math.max(0, currentCanvasY + (targetY - scrollerY) - 10)
			scroller.CanvasPosition = Vector2.new(scroller.CanvasPosition.X, newCanvasY)
		end)
		task.wait(0.15)
	end

	clickButton(targetButton)
end

-- === QTE & SKILLS LOGIC ===
local function handleQTE(button)
	if not button:IsA("GuiButton") or trackedButtons[button] then return end

	local buttonText = button:IsA("TextButton") and button.Text or ""
	local combined = (button.Name .. " " .. buttonText):upper()

	local isDodge = combined:find("DODGE")
	local isHit = combined:find("HIT")

	if not (isDodge or isHit) then return end

	trackedButtons[button] = true
	local isProcessing = false

	local function process()
		if isProcessing or not button.Visible then return end
		isProcessing = true

		if isDodge and Toggles.AutoDodge and Toggles.AutoDodge.Value then
			local delayVal = Options.DodgeDelay and Options.DodgeDelay.Value or 0
			if delayVal > 0 then task.wait(delayVal) end

			if button.Visible then
				clickButton(button)
				notify("D666Scripts", "Successfully Dodged!")
			end
		elseif isHit and Toggles.AutoHit and Toggles.AutoHit.Value then
			local delayVal = Options.HitDelay and Options.HitDelay.Value or 0
			if delayVal > 0 then task.wait(delayVal) end

			if button.Visible then
				clickButton(button)
				notify("D666Scripts", "Training Hit Executed!")
			end
		end

		task.wait(0.05)
		isProcessing = false
	end

	if button.Visible then
		task.spawn(process)
	end

	button:GetPropertyChangedSignal("Visible"):Connect(function()
		if button.Visible then
			task.spawn(process)
		end
	end)
end

for _, descendant in ipairs(playerGui:GetDescendants()) do
	handleQTE(descendant)
end

playerGui.DescendantAdded:Connect(function(descendant)
