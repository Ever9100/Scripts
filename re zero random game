local function getOrderedSkillButtons()
	local buttons = {}
	local skillsPanel = nil

	for _, desc in ipairs(playerGui:GetDescendants()) do
		if desc.Name == "SkillsPanel" and isReallyVisible(desc) then
			skillsPanel = desc
			break
		end
	end

	if not skillsPanel then return buttons end

	local setRow = skillsPanel:FindFirstChild("SetRow")
	if setRow then
		table.insert(buttons, setRow:FindFirstChild("Set_Flee"))
		table.insert(buttons, setRow:FindFirstChild("Set_Rest"))
		table.insert(buttons, setRow:FindFirstChild("Set_Guard"))
		table.insert(buttons, setRow:FindFirstChild("Set_LightAttack"))
		table.insert(buttons, setRow:FindFirstChild("Set_HeavyAttack"))
	end

	local activeRow = skillsPanel:FindFirstChild("ActiveRow")
	if activeRow then
		table.insert(buttons, activeRow:FindFirstChild("Active_1"))
		table.insert(buttons, activeRow:FindFirstChild("Active_2"))
		table.insert(buttons, activeRow:FindFirstChild("Active_3"))
		table.insert(buttons, activeRow:FindFirstChild("Active_4"))
		table.insert(buttons, activeRow:FindFirstChild("Active_5"))
	end

	return buttons
end

