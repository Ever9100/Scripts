function startPrideLoop()
    task.spawn(function()
        notify("D666Scripts", "Pride Route Automator Enabled", 3)
        while getgenv().AutoPride do
            if not isProcessingPride then
                isProcessingPride = true

                if isChoicePopupOpen() then
                    local selected = checkAndClickChoice()
                    task.wait(selected and 3.5 or 1.5)
                elseif handleLoopSettles() then
                    task.wait(2.5)
                elseif clickReadyToGoBack() then
                    task.wait(3.5)
                elseif clickContinueStory() then
                    task.wait(2.5)
                elseif clickReturn() then
                    task.wait(3.0)
                else
                    task.wait(1.0)
                end

                isProcessingPride = false
            end
            task.wait(0.4)
        end
        notify("D666Scripts", "Pride Route Automator Disabled", 3)
    end)
end

-- === AUTO JESTER'S DUNGEON (TREAT ONLY + AUTO-CLOSE POPUPS) ===
getgenv().AutoDungeonTreat = false
local isProcessingDungeon = false

local function processDungeonTreat()
    -- 1. Detectar y cerrar ventana emergerte de Info de Ítem (DetailShade -> Botón 'X')
    pcall(function()
        local pageHolder = playerGui:FindFirstChild("MainMenu") 
            and playerGui.MainMenu.Root:FindFirstChild("ContentPanel") 
            and playerGui.MainMenu.Root.ContentPanel:FindFirstChild("PageHolder")
            
        if pageHolder then
            local dungeonPage = pageHolder:FindFirstChild("Events|Dungeon")
            if dungeonPage and isReallyVisible(dungeonPage) then
                local detailShade = dungeonPage:FindFirstChild("DetailShade")
                if detailShade and isReallyVisible(detailShade) then
                    local detail = detailShade:FindFirstChild("Detail")
                    if detail then
                        local frame = detail:FindFirstChild("Frame")
                        if frame then
                            local closeBtn = frame:FindFirstChildOfClass("TextButton") or frame:FindFirstChild("TextButton")
                            if closeBtn and isReallyVisible(closeBtn) then
                                notify("D666Scripts", "Closed Item Detail Popup", 1.5)
                                clickChoiceButton(closeBtn)
                                return true
                            end
                        end
                    end
                end
            end
        end
    end)

    -- Búsqueda secundaria de botón 'X' en caso de variaciones
    for _, elem in ipairs(playerGui:GetDescendants()) do
        if isReallyVisible(elem) and elem:IsA("TextButton") and elem.Text == "X" then
            if elem:FindFirstAncestor("DetailShade") or elem.Parent.Name == "Frame" then
                clickChoiceButton(elem)
                return true
            end
        end
    end

    -- 2. Intentar clic directo en TakeTreat
    pcall(function()
        local pageHolder = playerGui:FindFirstChild("MainMenu") 
            and playerGui.MainMenu.Root:FindFirstChild("ContentPanel") 
            and playerGui.MainMenu.Root.ContentPanel:FindFirstChild("PageHolder")
            
        if pageHolder then
            local dungeonPage = pageHolder:FindFirstChild("Events|Dungeon")
            if dungeonPage and isReallyVisible(dungeonPage) then
                local runFrame = dungeonPage:FindFirstChild("Run")
                if runFrame and isReallyVisible(runFrame) then
                    local treatFrame = runFrame:FindFirstChild("Treat")
                    if treatFrame then
                        local takeTreatBtn = treatFrame:FindFirstChild("TakeTreat")
                        if takeTreatBtn and isReallyVisible(takeTreatBtn) then
                            clickChoiceButton(takeTreatBtn)
                            return true
                        end
                    end
                end
            end
        end
    end)

    -- 3. Búsqueda general por nombre o texto ("Take the Treat")
    for _, elem in ipairs(playerGui:GetDescendants()) do
        if isReallyVisible(elem) and (elem:IsA("TextButton") or elem:IsA("TextLabel")) then
            local textClean = cleanText(elem.Text)
            if elem.Name == "TakeTreat" or textClean == "take the treat" or string.find(textClean, "take the treat", 1, true) then
                local btn = elem:IsA("TextButton") and elem or elem:FindFirstAncestorOfClass("TextButton")
                if btn and isReallyVisible(btn) then
                    clickChoiceButton(btn)
                    return true
                end
            end
        end
    end

    -- 4. Reintentar / Reclamar si termina la run
    for _, elem in ipairs(playerGui:GetDescendants()) do
        if isReallyVisible(elem) and (elem:IsA("TextButton") or elem:IsA("TextLabel")) then
            local textClean = cleanText(elem.Text)
            if textClean == "start run" or textClean == "start" or textClean == "retry" or textClean == "claim rewards" or textClean == "claim" or textClean == "enter" then
                local btn = elem:IsA("TextButton") and elem or elem:FindFirstAncestorOfClass("TextButton")
                if btn and isReallyVisible(btn) then
                    clickChoiceButton(btn)
                    return true
                end
            end
        end
    end

    return false
end

function startDungeonLoop()
    task.spawn(function()
        notify("D666Scripts", "Jester's Dungeon Auto-Farm Enabled", 3)
        while getgenv().AutoDungeonTreat do
            if not isProcessingDungeon then
                isProcessingDungeon = true
                local delayVal = Options.DungeonDelay and Options.DungeonDelay.Value or 0.3
                local clicked = processDungeonTreat()
                
                if clicked then
                    task.wait(delayVal)
                else
                    task.wait(0.5)
                end
                isProcessingDungeon = false
            end
            task.wait(0.1)
        end
        notify("D666Scripts", "Jester's Dungeon Auto-Farm Disabled", 3)
    end)
end

