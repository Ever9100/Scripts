-- Creador de Filas (ESP ON/OFF + NOTIF ON/OFF)
local YOffset = 45

local function CreateESPRow(categoryKey, displayName)
	local rowSettings = Config[categoryKey]

	local Container = Instance.new("Frame")
	Container.Size = UDim2.new(0.92, 0, 0, 42)
	Container.Position = UDim2.new(0.04, 0, 0, YOffset)
	Container.BackgroundColor3 = Color3.fromRGB(32, 32, 40)
	Container.BorderSizePixel = 0
	Container.Parent = Frame

	local RowCorner = Instance.new("UICorner", Container)
	RowCorner.CornerRadius = UDim.new(0, 6)

	-- Nombre del ESP
	local Label = Instance.new("TextLabel")
	Label.Size = UDim2.new(0.45, 0, 1, 0)
	Label.Position = UDim2.new(0.03, 0, 0, 0)
	Label.BackgroundTransparency = 1
	Label.TextColor3 = Color3.fromRGB(230, 230, 230)
	Label.Font = Enum.Font.SourceSansSemiBold
	Label.TextSize = 14
	Label.TextXAlignment = Enum.TextXAlignment.Left
	Label.Text = string.format("%s %s", rowSettings.Icon, displayName)
	Label.Parent = Container

	-- Botón Toggle ESP
	local BtnESP = Instance.new("TextButton")
	BtnESP.Size = UDim2.new(0.24, 0, 0.65, 0)
	BtnESP.Position = UDim2.new(0.48, 0, 0.175, 0)
	BtnESP.Font = Enum.Font.SourceSansBold
	BtnESP.TextSize = 12
	BtnESP.Parent = Container

	local BtnESPCorner = Instance.new("UICorner", BtnESP)
	BtnESPCorner.CornerRadius = UDim.new(0, 4)

	local function UpdateESPBtn()
		if rowSettings.ESP then
			BtnESP.Text = "ESP: ON"
			BtnESP.BackgroundColor3 = Color3.fromRGB(46, 139, 87)
			BtnESP.TextColor3 = Color3.fromRGB(255, 255, 255)
		else
			BtnESP.Text = "ESP: OFF"
			BtnESP.BackgroundColor3 = Color3.fromRGB(80, 80, 90)
			BtnESP.TextColor3 = Color3.fromRGB(180, 180, 180)
		end
	end

	BtnESP.MouseButton1Click:Connect(function()
		rowSettings.ESP = not rowSettings.ESP
		UpdateESPBtn()
		if not rowSettings.ESP then
			RefreshCategory(categoryKey)
		end
	end)
	UpdateESPBtn()

	-- Botón Toggle Notificación
	local BtnNotif = Instance.new("TextButton")
	BtnNotif.Size = UDim2.new(0.23, 0, 0.65, 0)
	BtnNotif.Position = UDim2.new(0.74, 0, 0.175, 0)
	BtnNotif.Font = Enum.Font.SourceSansBold
	BtnNotif.TextSize = 12
	BtnNotif.Parent = Container

	local BtnNotifCorner = Instance.new("UICorner", BtnNotif)
	BtnNotifCorner.CornerRadius = UDim.new(0, 4)

	local function UpdateNotifBtn()
		if rowSettings.Notif then
			BtnNotif.Text = "🔔 ON"
			BtnNotif.BackgroundColor3 = Color3.fromRGB(218, 112, 214)
			BtnNotif.TextColor3 = Color3.fromRGB(255, 255, 255)
		else
			BtnNotif.Text = "🔕 OFF"
			BtnNotif.BackgroundColor3 = Color3.fromRGB(80, 80, 90)
			BtnNotif.TextColor3 = Color3.fromRGB(180, 180, 180)
		end
	end

	BtnNotif.MouseButton1Click:Connect(function()
		rowSettings.Notif = not rowSettings.Notif
		UpdateNotifBtn()
		if rowSettings.Notif then
			SendNotifier("D666Notifs", string.format("Notificaciones activadas para %s", displayName), 2)
		end
	end)
	UpdateNotifBtn()

	YOffset = YOffset + 48
end

-- Generar filas para cada módulo
CreateESPRow("BeanBugs", "Bean Bugs")
CreateESPRow("GoldCogmower", "Gold Cogmower")
CreateESPRow("ViciousSpikes", "Vicious Spikes")
CreateESPRow("HiddenStickers", "Stickers")

