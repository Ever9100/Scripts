local ReplicatedStorage = game:GetService("ReplicatedStorage")

local LocalPlayer = Players.LocalPlayer
local camera = workspace.CurrentCamera
local isAlive = true -- Variable de control global

-- Pre-creación del buffer optimizado para Auto Collect (Zero-GC)
local Event = ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Network"):WaitForChild("Events"):WaitForChild("ToolCollect")
local rawBytes = { 66, 83, 82, 80, 1, 0, 0 }
local cachedBuffer = buffer.create(#rawBytes)
for i = 1, #rawBytes do
    buffer.writeu8(cachedBuffer, i - 1, rawBytes[i])
end

