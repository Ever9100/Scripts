-- Función auxiliar de notificaciones (Compatibilidad Obsidian + Roblox)
local function sendNotification(title, text)
	pcall(function()
		if Library and Library.Notify then
			Library:Notify(title .. ": " .. text, 4)
		else
			StarterGui:SetCore("SendNotification", {
				Title = title,
				Text = text,
				Duration = 4
			})
		end
	end)
end

