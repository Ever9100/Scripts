-- -----------------------------------------------------------------
-- CONFIGURACIÓN GLOBAL Y ESTADOS (ESP + NOTIFICACIONES)
-- -----------------------------------------------------------------
local Config = {
	BeanBugs = { ESP = true, Notif = true, Color = Color3.fromRGB(0, 255, 150), Icon = "🫘" },
	GoldCogmower = { ESP = true, Notif = false, Color = Color3.fromRGB(255, 215, 0), Icon = "⚙️" },
	ViciousSpikes = { ESP = true, Notif = true, Color = Color3.fromRGB(170, 0, 255), Icon = "🌵" },
	HiddenStickers = { ESP = true, Notif = false, Color = Color3.fromRGB(255, 85, 85), Icon = "🏷️" },
}

-- Contenedor de objetos activos para limpiarlos dinámicamente
local ActiveESP = {
	BeanBugs = {},
	GoldCogmower = {},
	ViciousSpikes = {},
	HiddenStickers = {},
}

-- -----------------------------------------------------------------
-- SISTEMA DE NOTIFICACIONES
-- -----------------------------------------------------------------
local function SendNotifier(title, text, duration)
	pcall(function()
		StarterGui:SetCore("SendNotification", {
			Title = title,
			Text = text,
			Duration = duration or 4,
		})
	end)
end

-- -----------------------------------------------------------------
-- NÚCLEO DE GENERACIÓN DE ESP
-- -----------------------------------------------------------------
local function ApplyESP(category, instance, customName)
	if not instance then return end
	local settings = Config[category]
	if not settings or not settings.ESP then return end

	-- Evitar duplicados
	if ActiveESP[category][instance] then return end

	-- Determinar la parte primaria
	local primaryPart = instance:IsA("BasePart") and instance 
		or instance:FindFirstChild("BeanBody") 
		or instance:FindFirstChildWhichIsA("BasePart", true)

	if not primaryPart then return end

	-- 1. Highlight
	local highlight = Instance.new("Highlight")
	highlight.Name = "D666_Highlight"
	highlight.Adornee = instance
	highlight.FillColor = settings.Color
	highlight.FillTransparency = 0.45
	highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
	highlight.OutlineTransparency = 0
	highlight.Parent = instance

	-- 2. BillboardGui
	local billboard = Instance.new("BillboardGui")
	billboard.Name = "D666_Tag"
	billboard.Adornee = primaryPart
	billboard.Size = UDim2.new(0, 180, 0, 30)
	billboard.StudsOffset = Vector3.new(0, 3, 0)
	billboard.AlwaysOnTop = true
	billboard.Parent = instance

	local label = Instance.new("TextLabel")
	label.Size = UDim2.new(1, 0, 1, 0)
	label.BackgroundTransparency = 1
	label.TextColor3 = settings.Color
	label.TextStrokeTransparency = 0
	label.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
	label.Font = Enum.Font.SourceSansBold
	label.TextSize = 15
	label.Text = string.format("%s %s", settings.Icon, customName or instance.Name)
	label.Parent = billboard

	-- Guardar referencias para limpieza rápida
	ActiveESP[category][instance] = {
		Highlight = highlight,
		Billboard = billboard,
	}

	-- Notificación de aparición
	if settings.Notif then
		local char = LocalPlayer.Character
		local root = char and char:FindFirstChild("HumanoidRootPart")
		local distStr = ""
		if root then
			local dist = math.floor((primaryPart.Position - root.Position).Magnitude)
			distStr = string.format(" (%dm)", dist)
		end
		SendNotifier("D666Scripts ESP", string.format("¡%s %s detectado!%s", settings.Icon, customName or instance.Name, distStr), 5)
	end

	-- Bucle de distancia y limpieza automática
	task.spawn(function()
		while instance and instance.Parent and ActiveESP[category][instance] do
			if settings.ESP then
				local char = LocalPlayer.Character
				local root = char and char:FindFirstChild("HumanoidRootPart")
				if root and primaryPart then
					local dist = math.floor((primaryPart.Position - root.Position).Magnitude)
					label.Text = string.format("%s %s [%dm]", settings.Icon, customName or instance.Name, dist)
				end
			else
				highlight.Enabled = false
				billboard.Enabled = false
			end
			task.wait(0.3)
		end
	end)
end

local function ClearESP(category, instance)
	if ActiveESP[category][instance] then
		if ActiveESP[category][instance].Highlight then
			ActiveESP[category][instance].Highlight:Destroy()
		end
		if ActiveESP[category][instance].Billboard then
			ActiveESP[category][instance].Billboard:Destroy()
		end
		ActiveESP[category][instance] = nil
	end
end

local function RefreshCategory(category)
	for instance, _ in pairs(ActiveESP[category]) do
		ClearESP(category, instance)
	end
end

-- -----------------------------------------------------------------
-- ESCUCHADORES DE EVENTOS EN WORKSPACE
-- -----------------------------------------------------------------

-- 1. Bean Bugs
local beanFolder = Workspace:WaitForChild("BeanBugs", 5)
if beanFolder then
	beanFolder.ChildAdded:Connect(function(child)
		task.wait(0.1)
		ApplyESP("BeanBugs", child, "Bean Bug")
	end)
	beanFolder.ChildRemoving:Connect(function(child)
		ClearESP("BeanBugs", child)
	end)
	for _, v in ipairs(beanFolder:GetChildren()) do ApplyESP("BeanBugs", v, "Bean Bug") end
end

-- 2. Hidden Stickers
local stickerFolder = Workspace:WaitForChild("HiddenStickers", 5)
if stickerFolder then
	stickerFolder.ChildAdded:Connect(function(child)
		task.wait(0.1)
		ApplyESP("HiddenStickers", child, "Sticker Oculto")
	end)
	stickerFolder.ChildRemoving:Connect(function(child)
		ClearESP("HiddenStickers", child)
	end)
	for _, v in ipairs(stickerFolder:GetChildren()) do ApplyESP("HiddenStickers", v, "Sticker Oculto") end
end

-- 3. Gold Cogmower & Vicious Spikes (Monsters / Workspace)
local function CheckMonster(child)
	task.wait(0.1)
	local name = child.Name:lower()
	if name:find("cogmower") or name:find("goldcog") then
		ApplyESP("GoldCogmower", child, "Gold Cogmower")
	elseif name:find("vicious") or name:find("spike") then
		ApplyESP("ViciousSpikes", child, "Espina Vicious")
	end
end

Workspace.DescendantAdded:Connect(CheckMonster)
Workspace.DescendantRemoving:Connect(function(child)
	ClearESP("GoldCogmower", child)
	ClearESP("ViciousSpikes", child)
end)

for _, desc in ipairs(Workspace:GetDescendants()) do
	CheckMonster(desc)
end

