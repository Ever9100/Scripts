-- Función de limpieza de elementos visuales
local function removeESPInstance(target)
	if ActiveESP[target] then
		if ActiveESP[target].Highlight then ActiveESP[target].Highlight:Destroy() end
		if ActiveESP[target].Billboard then ActiveESP[target].Billboard:Destroy() end
		ActiveESP[target] = nil
	end
end

local function clearAllESP()
	for target, _ in pairs(ActiveESP) do
		removeESPInstance(target)
	end
	table.clear(ActiveESP)
end

Toggles.CogmowerEspToggle:OnChanged(clearAllESP)
Toggles.ViciousEspToggle:OnChanged(clearAllESP)
Toggles.StickerEspToggle:OnChanged(clearAllESP)
Toggles.BeanBugsEspToggle:OnChanged(clearAllESP)

-- Función para aplicar ESP
local function applyESP(target, displayName, defaultColor)
	if not target or ActiveESP[target] then return end

	local adorneePart = target:IsA("Model") and (target.PrimaryPart or target:FindFirstChildWhichIsA("BasePart")) or target
	if not adorneePart then return end

	-- Highlight (Chams)
	local highlight = Instance.new("Highlight")
	highlight.Name = "CamFollower_" .. target:GetDebugId()
	highlight.Adornee = target
	highlight.FillColor = defaultColor
	highlight.FillTransparency = 0.3
	highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
	highlight.OutlineTransparency = 0
	highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	highlight.Parent = camera

	-- BillboardGui (Texto)
	local billboard = Instance.new("BillboardGui")
	billboard.Name = "CamText_" .. target:GetDebugId()
	billboard.Size = UDim2.new(0, 200, 0, 50)
	billboard.StudsOffset = Vector3.new(0, 4.5, 0)
	billboard.AlwaysOnTop = true
	billboard.Adornee = adorneePart

	local textLabel = Instance.new("TextLabel")
	textLabel.Size = UDim2.new(1, 0, 1, 0)
	textLabel.BackgroundTransparency = 1
	textLabel.TextColor3 = defaultColor
	textLabel.TextSize = 14
	textLabel.Font = Enum.Font.RobotoMono
	textLabel.TextStrokeTransparency = 0
	textLabel.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
	textLabel.Parent = billboard
	billboard.Parent = camera

	ActiveESP[target] = {
		Highlight = highlight,
		Billboard = billboard,
		Text = textLabel,
		Part = adorneePart,
		DisplayName = displayName
	}
end

-- Motor de búsqueda centralizado
task.spawn(function()
	while isAlive do
		local char = LocalPlayer.Character
		local root = char and char:FindFirstChild("HumanoidRootPart")
		local currentTargets = {}

		-- 1. Gold Cogmower
		if Toggles.CogmowerEspToggle and Toggles.CogmowerEspToggle.Value then
			for _, child in ipairs(Workspace:GetChildren()) do
				if child.Name == "Gold Cogmower" then
					currentTargets[child] = { 
						Name = "Gold Cogmower", 
						Color = Options.CogmowerColor.Value,
						Notify = Toggles.CogmowerNotifToggle and Toggles.CogmowerNotifToggle.Value
					}
				end
			end
		end

		-- 2. Vicious Bee Spike
		if Toggles.ViciousEspToggle and Toggles.ViciousEspToggle.Value then
			local rogueFolder = Workspace:FindFirstChild("RogueViciousBee")
			if rogueFolder then
				for _, child in ipairs(rogueFolder:GetChildren()) do
					if child.Name == "ViciousBeeDormantSpike" or child.Name:find("Spike") then
						currentTargets[child] = { 
							Name = "Vicious Bee Spike", 
							Color = Options.ViciousColor.Value,
							Notify = Toggles.ViciousNotifToggle and Toggles.ViciousNotifToggle.Value
						}
					end
				end
			end
			for _, child in ipairs(Workspace:GetChildren()) do
				if child.Name == "ViciousBeeDormantSpike" then
					currentTargets[child] = { 
						Name = "Vicious Bee Spike", 
						Color = Options.ViciousColor.Value,
						Notify = Toggles.ViciousNotifToggle and Toggles.ViciousNotifToggle.Value
					}
				end
			end
		end

		-- 3. Hidden Stickers (workspace.HiddenStickers)
		if Toggles.StickerEspToggle and Toggles.StickerEspToggle.Value then
			local stickerFolder = Workspace:FindFirstChild("HiddenStickers")
			if stickerFolder then
				for _, child in ipairs(stickerFolder:GetChildren()) do
					local stickerName = (child.Name == "Hiddensticker" or child.Name == "HiddenSticker") and "Hidden Sticker" or child.Name
					currentTargets[child] = { 
						Name = stickerName, 
						Color = Options.StickerColor.Value,
						Notify = Toggles.StickerNotifToggle and Toggles.StickerNotifToggle.Value
					}
				end
			end
		end

		-- 4. Bean Bugs (workspace.BeanBugs)
		if Toggles.BeanBugsEspToggle and Toggles.BeanBugsEspToggle.Value then
			local beanFolder = Workspace:FindFirstChild("BeanBugs")
			if beanFolder then
				for _, child in ipairs(beanFolder:GetChildren()) do
					currentTargets[child] = { 
						Name = "Bean Bug", 
						Color = Options.BeanBugsColor.Value,
						Notify = Toggles.BeanBugsNotifToggle and Toggles.BeanBugsNotifToggle.Value
					}
				end
			end
		end

		-- Actualizar instancias de ESP y Notificaciones
		for target, info in pairs(currentTargets) do
			local adorneePart = target:IsA("Model") and (target.PrimaryPart or target:FindFirstChildWhichIsA("BasePart")) or target
			if adorneePart then
				local dist = root and (adorneePart.Position - root.Position).Magnitude or 0
				local isInRange = not Toggles.DistanceToggle.Value or (dist <= Options.MaxDistanceSlider.Value)

				if isInRange then
					-- Disparar notificación solo 1 vez por objeto detectado
					if info.Notify and not NotifiedTargets[target] then
						NotifiedTargets[target] = true
						sendNotification("D666Scripts ESP", string.format("¡%s detectado a %dm!", info.Name, math.floor(dist)))
					end

					if not ActiveESP[target] then
						applyESP(target, info.Name, info.Color)
					else
						ActiveESP[target].Highlight.FillColor = info.Color
						ActiveESP[target].Text.TextColor3 = info.Color
						
						local displayString = ""
						if Toggles.NameToggle.Value then displayString = info.Name .. "\n" end
						displayString = displayString .. math.floor(dist) .. "m"
						ActiveESP[target].Text.Text = displayString
					end
				else
					removeESPInstance(target)
				end
			end
		end

		-- Limpieza de targets destruidos o desanimados
		for target, _ in pairs(ActiveESP) do
			if not currentTargets[target] or not target.Parent then
				removeESPInstance(target)
			end
		end

		for target, _ in pairs(NotifiedTargets) do
			if not currentTargets[target] or not target.Parent then
				NotifiedTargets[target] = nil
			end
		end

		task.wait(0.2)
	end
end)

