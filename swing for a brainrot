-- Tabla maestra de colores estables por mutación
local MutationColors = {
	["normal"]      = Color3.fromRGB(150, 150, 150), -- Gris
	["golden"]      = Color3.fromRGB(255, 200, 0),   -- Oro
	["diamond"]     = Color3.fromRGB(0, 230, 255),   -- Diamante
	["emerald"]     = Color3.fromRGB(40, 255, 110),  -- Esmeralda
	["ruby"]        = Color3.fromRGB(255, 40, 40),   -- Rubí
	["rainbow"]     = Color3.fromRGB(255, 100, 200), -- Neón
	["radioactive"] = Color3.fromRGB(100, 255, 0),   -- Radiactivo
	["lava"]        = Color3.fromRGB(255, 90, 0),    -- Lava
	["void"]        = Color3.fromRGB(130, 0, 255),   -- Vacío
	["ethereal"]    = Color3.fromRGB(180, 240, 255), -- Etéreo
	["celestial"]   = Color3.fromRGB(255, 255, 130)  -- Celestial
}

