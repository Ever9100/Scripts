------------------------------------------------------------------------
-- 4. MANEJO DE LIMPIEZA DE ENTORNO

local function clearAllESP()
	for _, child in camera:GetChildren() do
		if child.Name:sub(1, 12) == "CamFollower_" or child.Name:sub(1, 8) == "CamText_" then
			child:Destroy()
		end
	end
end

Toggles.EspTrackerToggle:OnChanged(function()
	if not Toggles.EspTrackerToggle.Value then
		clearAllESP()
	end
end)

Options.MutationDropdown:OnChanged(function()
	clearAllESP()
end)

------------------------------------------------------------------------
-- 5. MOTOR DE ESCANEO ULTRA-PRECISO POR ID ÚNICO

task.spawn(function()
	while true do
		if Toggles.EspTrackerToggle and Toggles.EspTrackerToggle.Value then
			
			local selectedMutations = Options.MutationDropdown and Options.MutationDropdown.Value or {}
			local activeFolder = workspace:FindFirstChild("ActiveBrainrots", true)
			
			if activeFolder then
				for _, object in activeFolder:GetDescendants() do
					if object:IsA("Model") then
						local mutationAttribute = object:GetAttribute("Mutation")
						
						local isSelected = false
						local properName = ""
						
						if mutationAttribute then
							for dropdownKey, isActive in pairs(selectedMutations) do
								if isActive and string.lower(dropdownKey) == string.lower(tostring(mutationAttribute)) then
									isSelected = true
									properName = dropdownKey
									break
								end
							end
						end
						
						-- Identificador único por instancia para fulminar los parpadeos
						local uniqueId = object:GetDebugId()
						local idName = "CamFollower_" .. uniqueId
						local textIdName = "CamText_" .. uniqueId
						
						if isSelected then
							local pickedColor = MutationColors[string.lower(properName)] or Color3.fromRGB(255, 255, 255)
							
							-- REGLA A: Contorno Externo X-Ray
							if not camera:FindFirstChild(idName) then
								local chams = Instance.new("Highlight")
								chams.Name = idName
								chams.FillColor = pickedColor
								chams.FillTransparency = 0.3
								chams.OutlineColor = Color3.fromRGB(255, 255, 255)
								chams.OutlineTransparency = 0
								chams.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
								chams.Adornee = object
								chams.Parent = camera
							end
							
							-- REGLA B: Texto de Mutación Flotante Superior
							if not camera:FindFirstChild(textIdName) then
								local billboard = Instance.new("BillboardGui")
								billboard.Name = textIdName
								billboard.Size = UDim2.new(0, 150, 0, 30)
								billboard.StudsOffset = Vector3.new(0, 4.5, 0)
								billboard.AlwaysOnTop = true
								billboard.Adornee = object
								
								local textLabel = Instance.new("TextLabel")
								textLabel.Size = UDim2.new(1, 0, 1, 0)
								textLabel.BackgroundTransparency = 1
								textLabel.Text = properName:upper()
								textLabel.TextColor3 = pickedColor
								textLabel.TextSize = 14
								textLabel.Font = Enum.Font.RobotoMono
								textLabel.TextStrokeTransparency = 0 
								textLabel.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
								
								textLabel.Parent = billboard
								billboard.Parent = camera
							end
						else
							if camera:FindFirstChild(idName) then camera[idName]:Destroy() end
							if camera:FindFirstChild(textIdName) then camera[textIdName]:Destroy() end
						end
					end
				end
				
				-- Limpieza de caché
				for _, child in camera:GetChildren() do
					if child.Name:sub(1, 12) == "CamFollower_" or child.Name:sub(1, 8) == "CamText_" then
						if not child.Adornee or not child.Adornee:IsDescendantOf(workspace) then
							child:Destroy()
						end
					end
				end
				
			end
		end
		task.wait(0.5)
	end
end)

