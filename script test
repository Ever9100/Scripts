local function cargarAssetLocal(nombreBase)
    if not isfile then return nil end
    local posiblesNombres = {
        nombreBase, nombreBase .. ".png", nombreBase .. ".mp3",
        nombreBase:gsub("%.png$", ""), nombreBase:gsub("%.mp3$", "")
    }
    for _, nombre in ipairs(posiblesNombres) do
        if isfile(nombre) then
            if getcustomasset then return getcustomasset(nombre)
            elseif getsynasset then return getsynasset(nombre) end
        end
    end
    return nil
end

