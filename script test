local function aplicarAmbiente(activo)
    if activo then
        for _, child in pairs(Lighting:GetChildren()) do
            if child:IsA("Sky") or child:IsA("Atmosphere") then child:Destroy() end
        end
        memeSky.Parent = Lighting
        Lighting.Ambient = Color3.fromRGB(0, 56, 184)
        Lighting.OutdoorAmbient = Color3.fromRGB(255, 255, 255)
        Lighting.Brightness = 3
    else
        memeSky.Parent = nil
        Lighting.Ambient = Color3.fromRGB(128, 128, 128)
        Lighting.OutdoorAmbient = Color3.fromRGB(128, 128, 128)
        Lighting.Brightness = 2
        for _, sky in pairs(skyboxOriginales) do
            sky:Clone().Parent = Lighting
        end
    end
end

