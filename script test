-- 4. 📐 RASTREO Y LÓGICA
local jugadoresDetectados = {}
local marcasVisuales = {}

local function removerMarcador(jugador)
    if marcasVisuales[jugador] then
        marcasVisuales[jugador]:Destroy()
        marcasVisuales[jugador] = nil
    end
    jugadoresDetectados[jugador] = nil
end

local function limpiarTodo()
    for jugador in pairs(marcasVisuales) do
        removerMarcador(jugador)
    end
end

