local function sonarDetectedConDuck()
    if not baseSoundDetected then return end
    
    if bgAudio and bgAudio.IsPlaying then
        bgAudio.Volume = config.volumenMusicaBase * 0.2
    end
    
    local sonidoClon = baseSoundDetected:Clone()
    sonidoClon.Volume = config.volumenDetected
    sonidoClon.Parent = SoundService
    sonidoClon:Play()
    
    task.delay(1.5, function()
        if bgAudio then
            bgAudio.Volume = config.volumenMusicaBase
        end
    end)
    
    game:GetService("Debris"):AddItem(sonidoClon, 3)
end

