        for jugador in pairs(marcasVisuales) do removerMarcador(jugador) end
        for _, star in pairs(cornerStars) do star.Visible = false end
        shiftlockStar.Visible = false
    end
end)

local function estaEnCampoDeVision(pos)
    local cf = Camera.CFrame
    return cf.LookVector:Dot((pos - cf.Position).Unit) >= math.cos(math.rad(config.angulo / 2))
end

local function actualizarPartes3D(enemigo, personaje, torso)
    local datosVis = marcasVisuales[enemigo]
    
    if not datosVis then
        datosVis = {}
        
        local guiEstrella = Instance.new("BillboardGui")
        guiEstrella.Name = "EstrellaTracker"; guiEstrella.Size = UDim2.new(config.escalaMundo, 0, config.escalaMundo, 0)
        guiEstrella.AlwaysOnTop = true; guiEstrella.Adornee = torso; guiEstrella.Parent = Workspace

        local imgEstrella = Instance.new("ImageLabel")
        imgEstrella.Name = "EstrellaImg"; imgEstrella.Size = UDim2.new(1, 0, 1, 0); imgEstrella.BackgroundTransparency = 1
        imgEstrella.BorderSizePixel = 0; imgEstrella.Image = customEstrellaAsset; imgEstrella.Parent = guiEstrella
        
        local guiESP = Instance.new("BillboardGui")
        guiESP.Name = "ESPTracker"; guiESP.Size = UDim2.new(0, 150, 0, 40); guiESP.StudsOffset = Vector3.new(0, 3, 0) 
        guiESP.AlwaysOnTop = true; guiESP.Adornee = personaje:FindFirstChild("Head") or torso; guiESP.Parent = Workspace
        
        local txtESP = Instance.new("TextLabel")
        txtESP.Name = "NameESP"; txtESP.Size = UDim2.new(1, 0, 1, 0); txtESP.BackgroundTransparency = 1
        txtESP.Text = enemigo.DisplayName; txtESP.TextColor3 = Color3.fromRGB(0, 30, 120)
        txtESP.TextStrokeColor3 = Color3.fromRGB(255, 255, 255); txtESP.TextStrokeTransparency = 0.2
        txtESP.Font = Enum.Font.GothamBlack; txtESP.TextSize = config.tamanoTextoESP; txtESP.Parent = guiESP
        
        local chams = Instance.new("Highlight")
        chams.Name = "ChamsTracker"; chams.Adornee = personaje; chams.FillColor = Color3.fromRGB(0, 0, 100) 
        chams.FillTransparency = 0.4; chams.OutlineColor = Color3.fromRGB(0, 56, 184); chams.OutlineTransparency = 0; chams.Parent = Workspace
        
        datosVis.estrella = guiEstrella
        datosVis.esp = guiESP
        datosVis.chams = chams
        marcasVisuales[enemigo] = datosVis
    end

    if datosVis.estrella then
        datosVis.estrella.Size = UDim2.new(config.escalaMundo, 0, config.escalaMundo, 0)
        local img = datosVis.estrella:FindFirstChild("EstrellaImg")
        if img then img.Rotation = (img.Rotation + config.velocidadGiro) % 360 end
    end
    
    if datosVis.esp and datosVis.esp:FindFirstChild("NameESP") then
        datosVis.esp.NameESP.TextSize = config.tamanoTextoESP
    end
    
    if datosVis.chams then
        datosVis.chams.Enabled = config.mostrarChams
    end
end

