        aplicarAmbiente(false)
        if bgAudio then bgAudio:Stop() end
        limpiarTodo()
    end
end)

local function estaEnCampoDeVision(posicionObjetivo)
    local camaraCF = Camera.CFrame
    local direccionAObjetivo = (posicionObjetivo - camaraCF.Position).Unit
    local vectorMirada = camaraCF.LookVector
    local productoPunto = vectorMirada:Dot(direccionAObjetivo)
    local limiteAngulo = math.cos(math.rad(config.angulo / 2))
    return productoPunto >= limiteAngulo
end

local function crearOActualizarEstrella(enemigo, torso)
    local gui = marcasVisuales[enemigo]
    if not gui then
        gui = Instance.new("BillboardGui")
        gui.Name = "EstrellaTracker"
        gui.Size = UDim2.new(0, config.tamanoEstrella, 0, config.tamanoEstrella)
        gui.SizeOffset = Vector2.new(0, 0)
        gui.AlwaysOnTop = true
        gui.Adornee = torso
        gui.Parent = Workspace

        local imagen = Instance.new("ImageLabel")
        imagen.Name = "EstrellaImg"
        imagen.Size = UDim2.new(1, 0, 1, 0)
        imagen.BackgroundTransparency = 1
        imagen.BorderSizePixel = 0
        imagen.Image = customEstrellaAsset or idEstrellaFallback
        imagen.Parent = gui

        marcasVisuales[enemigo] = gui
    else
        gui.Size = UDim2.new(0, config.tamanoEstrella, 0, config.tamanoEstrella)
    end

    local imagenLabel = gui:FindFirstChild("EstrellaImg")
    if imagenLabel then
        imagenLabel.Rotation = (imagenLabel.Rotation + config.velocidadGiro) % 360
    end
end

