local memeSky = Instance.new("Sky")
memeSky.Name = "MemeSkyD666"
memeSky.SkyboxBk = idImagenIsraelSky; memeSky.SkyboxDn = idImagenIsraelSky
memeSky.SkyboxFt = idImagenIsraelSky; memeSky.SkyboxLf = idImagenIsraelSky
