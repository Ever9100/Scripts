RunService.RenderStepped:Connect(function()
    if not config.israelMode then return end

    local miPersonaje = LocalPlayer.Character
    if not miPersonaje or not miPersonaje:FindFirstChild("HumanoidRootPart") then return end
    local miPosicion = miPersonaje.HumanoidRootPart.Position

    for _, enemigo in pairs(Players:GetPlayers()) do
        if enemigo ~= LocalPlayer and enemigo.Character and enemigo.Character:FindFirstChild("HumanoidRootPart") and enemigo.Character:FindFirstChild("Humanoid") and enemigo.Character.Humanoid.Health > 0 then
            
            local esMismoEquipo = (enemigo.Team ~= nil and enemigo.Team == LocalPlayer.Team) or (enemigo.TeamColor == LocalPlayer.TeamColor)
            if esMismoEquipo and not config.detectarTeam then
                removerMarcador(enemigo)
                continue
            end

            local torso = enemigo.Character:FindFirstChild("Torso") 
                       or enemigo.Character:FindFirstChild("UpperTorso") 
                       or enemigo.Character.HumanoidRootPart
                       
            local posicionEnemigo = torso.Position
            local distancia = (posicionEnemigo - miPosicion).Magnitude

            local enRango = distancia <= config.rango
            local yaFijado = jugadoresDetectados[enemigo] == true

            if not yaFijado then
                local enVista = estaEnCampoDeVision(posicionEnemigo)
                if enRango and enVista then
                    jugadoresDetectados[enemigo] = true
                    sonarDetectedConDuck()
                    crearOActualizarEstrella(enemigo, torso)
                end
            else
                if enRango then
                    crearOActualizarEstrella(enemigo, torso)
                else
                    removerMarcador(enemigo)
                end
            end
        else
            removerMarcador(enemigo)
        end
    end
end)

