local closestEnemy = nil
local closestDist = math.huge

RunService.RenderStepped:Connect(function()
    if not config.israelMode then return end

    for _, star in pairs(cornerStars) do
        star.Rotation = (star.Rotation + config.velocidadGiro) % 360
    end

    if UserInputService.MouseBehavior == Enum.MouseBehavior.LockCenter then
        shiftlockStar.Visible = true
        shiftlockStar.Rotation = (shiftlockStar.Rotation + config.velocidadGiro) % 360
    else
        shiftlockStar.Visible = false
    end

    local miPersonaje = LocalPlayer.Character
    if not miPersonaje or not miPersonaje:FindFirstChild("HumanoidRootPart") then return end
    local miPosicion = miPersonaje.HumanoidRootPart.Position

    closestEnemy = nil
    closestDist = math.huge

    for _, enemigo in pairs(Players:GetPlayers()) do
        if enemigo ~= LocalPlayer and enemigo.Character and enemigo.Character:FindFirstChild("HumanoidRootPart") and enemigo.Character:FindFirstChild("Humanoid") and enemigo.Character.Humanoid.Health > 0 then
            
            local esMismoEquipo = (enemigo.Team ~= nil and enemigo.Team == LocalPlayer.Team) or (enemigo.TeamColor == LocalPlayer.TeamColor)
            if esMismoEquipo and not config.detectarTeam then
                removerMarcador(enemigo)
                continue
            end

            local torso = enemigo.Character:FindFirstChild("Torso") or enemigo.Character:FindFirstChild("UpperTorso") or enemigo.Character.HumanoidRootPart
            local distancia = (torso.Position - miPosicion).Magnitude
            local enRango = distancia <= config.rango
            local yaFijado = jugadoresDetectados[enemigo] == true

            if not yaFijado then
                local enVista = estaEnCampoDeVision(torso.Position)
                if enRango and enVista then
                    jugadoresDetectados[enemigo] = true
                    sonarDetectedConDuck()
                    actualizarPartes3D(enemigo, enemigo.Character, torso)
                    
                    if distancia < closestDist then
                        closestDist = distancia
                        closestEnemy = enemigo
                    end
                end
            else
                if enRango then 
                    actualizarPartes3D(enemigo, enemigo.Character, torso)
                    
                    if distancia < closestDist then
                        closestDist = distancia
                        closestEnemy = enemigo
                    end
                else 
                    removerMarcador(enemigo) 
                end
            end
        else
            removerMarcador(enemigo)
        end
    end

    -- 🔄 ACTUALIZACIÓN DEL HUD ÚNICO
    if closestEnemy then
        closestTargetHUD.Visible = true
        txtTargetNameHUD.Text = closestEnemy.Name
        avatarImgHUD.Image = "rbxthumb://type=AvatarHeadShot&id=" .. closestEnemy.UserId .. "&w=150&h=150"
        local humanoid = closestEnemy.Character:FindFirstChild("Humanoid")
        if humanoid then
            local porcentajeVida = math.clamp(humanoid.Health / humanoid.MaxHealth, 0, 1)
            healthFillHUD.Size = UDim2.new(porcentajeVida, 0, 1, 0)
        end
    else
        -- MODO EDICIÓN: Si abres el menú, el HUD se muestra para que puedas acomodarlo
        if Panel.Visible then
            closestTargetHUD.Visible = true
            txtTargetNameHUD.Text = "[Modo Edición]"
            avatarImgHUD.Image = "" -- Sin avatar en modo de prueba
            healthFillHUD.Size = UDim2.new(0.5, 0, 1, 0) -- Vida a la mitad de prueba
        else
            closestTargetHUD.Visible = false
        end
    end
end)

